<?xml version="1.0" encoding="UTF-8"?>
<sequence name="R1AcceptPayoutTransactionSequence" trace="disable" xmlns="http://ws.apache.org/ns/synapse">
    <payloadFactory media-type="xml">
        <format>
            <params xmlns="">
                <trans_ref>$1</trans_ref>
                <username>$2</username>
                <password>$3</password>
                <pin>$4</pin>
                <bank_name>$5</bank_name>
            </params>
        </format>
        <args>
            <arg evaluator="xml" expression="get-property('TransactionReference')"/>
            <arg evaluator="xml" expression="get-property('R1_username')"/>
            <arg evaluator="xml" expression="get-property('R1_password')"/>
            <arg evaluator="xml" expression="get-property('R1_pin')"/>
            <arg evaluator="xml" expression="get-property('BankName')"/>
        </args>
    </payloadFactory>
    <switch source="get-property('BankTransactionStatus')">
        <case regex="Received">
            <switch source="get-property('AcceptTransaction')">
                <case regex="0">
                    <send receive="R1ProcessPayoutTransactionSequence">
                        <endpoint key="R1AcceptPayoutTransactionsEndpoint"/>
                    </send>
                </case>
                <default>
                    <respond/>
                </default>
            </switch>
        </case>
        <case regex="Completed">
            <switch source="get-property('AcceptTransaction')">
                <case regex="0">
                    <send receive="R1ProcessPayoutTransactionSequence">
                        <endpoint key="R1AcceptPayoutTransactionsEndpoint"/>
                    </send>
                </case>
                <case regex="1">
                    <sequence key="R1ProcessPayoutTransactionSequence"/>
                </case>
                <default/>
            </switch>
        </case>
        <case regex="Cancelled">
            <sequence key="R1HandleCancellationSequence"/>
        </case>
        <case regex="Error">
            <sequence key="R1HandleErrorSequence"/>
        </case>
        <default/>
    </switch>
</sequence>
